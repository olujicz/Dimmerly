--swift-version 6.0
--minversion 0.64.4
--indent 4
--linebreaks lf
--header ignore
--disable numberFormatting
--disable environmentEntry
--disable repeatedGuard
--disable nestedIf

--binary-grouping none
--decimal-grouping none
--hex-grouping none
--hex-literal-case lowercase
--octal-grouping none

--wrap-collections before-first
--wrap-parameters before-first

--exclude .build
--exclude tools
